# Rust
/target/
# The workspace root lockfile is tracked; member-local locks are not authoritative.
**/Cargo.lock
!/Cargo.lock

# IDE
.idea/
.vscode/
*.swp
*.swo

# macOS
.DS_Store

# ESP-IDF build artifacts
/.embuild/
/firmware/build/
/firmware/sdkconfig
/firmware/sdkconfig.old

# Web UI
/web/node_modules/
/web/.next/
/web/out/
/web/tsconfig.tsbuildinfo

# ROM files (user-provided, not committed)
*.rom
*.ROM
*.ext
*.EXT

# Disk images (user-provided, not committed)
*.adf
*.ADF
*.adz
*.ADZ
*.hda
*.HDA
*.hdf
*.HDF

# Default desktop REST media root
/rumiga-media/
