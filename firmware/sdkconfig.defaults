CONFIG_IDF_TARGET="esp32p4"

# D1001 hardware baseline, independently reproduced from the audited Vellum
# bring-up revision recorded in toolchain/manifest.toml.
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# The table sits at 0x10000 so the bootloader has a 56 KiB window; the stock
# 0x8000 offset leaves 480 bytes and cannot hold a Secure Boot V2 signature.
#
# The product layout lives in `firmware/partitions.csv` and is applied when the
# flashable image is generated. `esp-idf-sys` documents that a custom table in
# `sdkconfig.defaults` is ignored by its generated CMake project, so the table
# the ESP-IDF build emits is a build artifact and not the shipped layout.
CONFIG_PARTITION_TABLE_OFFSET=0x10000
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

# Flash encryption in Development mode. Release mode permanently removes plaintext
# ROM-download flashing and therefore the cable as a recovery path, so it is
# deliberately deferred until the recovery path is decided.
#
# EFUSE_VIRTUAL keeps this pre-hardware phase from burning eFuses on the first
# board that boots this firmware. It also makes Release mode unselectable, because
# SECURE_FLASH_ENCRYPTION_MODE_RELEASE depends on !EFUSE_VIRTUAL, so a production
# image cannot be produced by accident. Both settings change together with the
# first hardware bring-up.
CONFIG_SECURE_FLASH_ENC_ENABLED=y
CONFIG_SECURE_FLASH_ENCRYPTION_MODE_DEVELOPMENT=y
CONFIG_EFUSE_VIRTUAL=y

# Flash encryption implies NVS encryption. ESP-IDF defaults to the HMAC scheme on
# SoCs with an HMAC peripheral, whose eFuse key ID defaults to -1 and fails the
# build. The flash-encryption scheme instead uses the `nvs_keys` partition the
# layout already reserves and consumes no eFuse key block, which keeps blocks free
# for the flash-encryption key and Secure Boot digests. Switching to HMAC later is
# a configuration change and burns one key block; it moves no partition.
CONFIG_NVS_SEC_KEY_PROTECT_USING_FLASH_ENC=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_100=y

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=8192
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536
CONFIG_CACHE_L2_CACHE_256KB=y
CONFIG_CACHE_L2_CACHE_LINE_128B=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_400=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
