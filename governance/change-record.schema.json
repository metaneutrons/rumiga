{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/metaneutrons/rumiga/schemas/change-record-v1.json",
  "title": "Rumiga change record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "task_id",
    "title",
    "status",
    "summary",
    "scope",
    "risk",
    "compatibility",
    "security",
    "tests",
    "evidence",
    "documentation",
    "release_note",
    "architecture_decisions"
  ],
  "properties": {
    "schema": {
      "const": "rumiga.change-record.v1"
    },
    "task_id": {
      "type": "string",
      "pattern": "^(BASE|M[0-9]+)-[0-9]{3}$"
    },
    "title": { "type": "string", "minLength": 1 },
    "status": {
      "enum": ["planned", "implemented", "verified", "released"]
    },
    "summary": { "type": "string", "minLength": 1 },
    "scope": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "failure_mode", "rollback"],
      "properties": {
        "level": { "enum": ["low", "medium", "high", "critical"] },
        "failure_mode": { "type": "string", "minLength": 1 },
        "rollback": { "type": "string", "minLength": 1 }
      }
    },
    "compatibility": { "$ref": "#/$defs/impact" },
    "security": { "$ref": "#/$defs/impact" },
    "tests": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/test" }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/evidence" }
    },
    "documentation": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "release_note": { "type": "string", "minLength": 1 },
    "architecture_decisions": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "impact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "detail"],
      "properties": {
        "status": { "enum": ["none", "affected"] },
        "detail": { "type": "string", "minLength": 1 }
      }
    },
    "test": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "command", "proves"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "command": { "type": "string", "minLength": 1 },
        "proves": { "type": "string", "minLength": 1 }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "location", "proves"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["command", "ci-artifact", "host-scenario", "hil"] },
        "location": { "type": "string", "minLength": 1 },
        "proves": { "type": "string", "minLength": 1 }
      }
    }
  }
}
