[package]
name = "m68k"
version = "0.1.5"
edition = "2024"
license = "MIT"
description = "A safe Rust M68000 family CPU emulator"
repository = "https://github.com/metaneutrons/rumiga"
keywords = ["m68k", "68000", "68040", "cpu", "emulator"]
categories = ["emulators"]
exclude = ["tests/**/*"]

[features]
default = ["std", "fpu"]
std = []
no_std = []
fpu = []

[[bin]]
name = "m68k"
path = "src/main.rs"
required-features = ["std"]

[dependencies]

[dev-dependencies]
serde = { version = "1.0", features = ["derive"] }
serde_json = "1.0"
