{
  "name": "rumiga-web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24.20.0 <27"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "export": "next build",
    "prepare": "cd .. && web/node_modules/.bin/lefthook install --reset-hooks-path"
  },
  "dependencies": {
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "~9.39.5",
    "@tailwindcss/postcss": "^4.3.4",
    "@types/node": "~24.13.3",
    "@types/react": "^19.3.0",
    "@vitest/coverage-v8": "~5.1.0",
    "eslint": "~9.39.5",
    "eslint-config-next": "^16.4.5",
    "lefthook": "~2.2.2",
    "postcss": "8.5.32",
    "tailwindcss": "^4.3.4",
    "typescript": "~6.0.3",
    "typescript-eslint": "~8.72.1",
    "vitest": "~5.1.0"
  },
  "overrides": {
    "postcss": "8.5.32"
  },
  "allowScripts": {
    "unrs-resolver": false
  }
}
